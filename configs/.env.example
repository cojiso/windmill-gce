# Copied to .env on first setup. setup-vm.sh refuses to start while a value marked __CHANGE_ME__ is still unset.
# On GCE, the Pulumi stack fills WINDMILL_DOMAIN, COMPOSE_PROFILES and BACKUP_BUCKET, and setup-vm.sh generates POSTGRES_PASSWORD.

# caddy or tunnel
COMPOSE_PROFILES=caddy

# Host name only, without https://
WINDMILL_DOMAIN=__CHANGE_ME__

POSTGRES_USER=windmill
POSTGRES_PASSWORD=__CHANGE_ME__

# Only for the tunnel profile: the token of the tunnel created in Cloudflare Zero Trust → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Where everything that grows lives: Postgres, logs, caches, certificates, backups.
DATA_DIR=/mnt/data

# GCS bucket for the nightly dump, without gs://. Empty keeps the dumps on the data disk instead.
BACKUP_BUCKET=
