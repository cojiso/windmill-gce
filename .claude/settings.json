{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(wmill init)",
      "Bash(wmill init *)",
      "Bash(wmill * --yes*)",
      "Bash(wmill * -y)",
      "Bash(wmill * -y *)"
    ],
    "ask": [
      "Bash(wmill sync *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-wmill.sh"
          }
        ]
      }
    ]
  }
}
